#
# Verifies that source files in this repository carry an ASF license header,
# by running Apache RAT (Release Audit Tool) over the working tree.
#
# Scope: SOURCE HEADERS ONLY. Despite the name, this script does not look at
# third-party dependencies, and passing it says nothing about whether the
# LICENSE and NOTICE shipped with the binary distribution accurately describe
# what the assembly jar bundles. That is a separate concern, documented in
# etc/legal/README.md, and is currently a manual audit.
#
# Usage:   etc/tools/check-licenses
#
# Files exempt from the header requirement are listed in
# etc/tools/.rat-excludes. Add an entry there for generated files and for
# formats that cannot carry comments, not to silence a fixable warning.
#
# The RAT jar is downloaded on first run and cached in etc/tools/.
#
# Output:  target/rat-results.txt
# Exit:    0 if every file has a header, 1 if any file lacks one or RAT failed.
#

acquire_rat_jar () {

  URL="https://repo1.maven.org/maven2/org/apache/rat/apache-rat/${RAT_VERSION}/apache-rat-${RAT_VERSION}.jar"

  JAR="$rat_jar"

  # Download rat launch jar if it hasn't been downloaded yet
  if [ ! -f "$JAR" ]; then
    # Download
    printf "Attempting to fetch rat\n"
    JAR_DL="${JAR}.part"
    if [ $(command -v curl) ]; then
      curl -L --silent "${URL}" > "$JAR_DL" && mv "$JAR_DL" "$JAR"
    elif [ $(command -v wget) ]; then
      wget --quiet ${URL} -O "$JAR_DL" && mv "$JAR_DL" "$JAR"
    else
      printf "You do not have curl or wget installed, please install rat manually.\n"
      exit -1
    fi
  fi

  unzip -tq "$JAR" &> /dev/null
  if [ $? -ne 0 ]; then 
    # We failed to download
    rm "$JAR"
    printf "Our attempt to download rat locally to ${JAR} failed. Please install rat manually.\n"
    exit -1
  fi
}

# Go to the Toree project root directory
FWDIR="$(cd "`dirname "$0"`"/../../; pwd)"
cd "$FWDIR"

if test -x "$JAVA_HOME/bin/java"; then
    declare java_cmd="$JAVA_HOME/bin/java"
else
    declare java_cmd=java
fi

export RAT_VERSION=0.12
export rat_jar="$FWDIR"/etc/tools/apache-rat-${RAT_VERSION}.jar

[[ -f "$rat_jar" ]] || acquire_rat_jar || {
    echo "Download failed. Obtain the rat jar manually and place it at $rat_jar"
    exit 1
}

mkdir -p target
$java_cmd -jar "$rat_jar" -E "$FWDIR"/etc/tools/.rat-excludes -d "$FWDIR" > target/rat-results.txt

if [ $? -ne 0 ]; then
   echo "RAT exited abnormally"
   exit 1
fi

ERRORS="$(cat target/rat-results.txt | grep -e "??")"

if test ! -z "$ERRORS"; then 
    echo "Could not find Apache license headers in the following files:"
    echo "$ERRORS"
    exit 1
else 
    echo -e "RAT checks passed."
fi
